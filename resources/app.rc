#include <winver.h>
#include "resource.h"
#include "version_info.hpp"

IDI_APPICON ICON "AppIcon.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION GEEKDESK_VERSION_MAJOR,GEEKDESK_VERSION_MINOR,GEEKDESK_VERSION_PATCH,0
 PRODUCTVERSION GEEKDESK_VERSION_MAJOR,GEEKDESK_VERSION_MINOR,GEEKDESK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ockham's Hunter Workshop"
            VALUE "FileDescription", "GeekDeskCpp Native Desktop Launcher"
            VALUE "FileVersion", GEEKDESK_VERSION_STR
            VALUE "InternalName", "GeekDeskCpp.exe"
            VALUE "OriginalFilename", "GeekDeskCpp.exe"
            VALUE "ProductName", "GeekDeskCpp"
            VALUE "ProductVersion", GEEKDESK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
